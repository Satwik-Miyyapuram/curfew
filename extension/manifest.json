{
  "manifest_version": 3,
  "name": "Curfew",
  "version": "0.1.0",
  "description": "Lets Curfew see which page a tab is on, so rules can name a path and not just a site.",
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": { "id": "curfew@curfew.dev", "strict_min_version": "115.0" }
  }
}
