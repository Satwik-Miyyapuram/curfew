<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer.

  Everything a person had to type before — `curfew install`, an administrator terminal, a PATH entry
  — happens here instead, once, behind the one UAC prompt Windows shows for any installer. The
  service is registered by the program's own `install` verb rather than by MSI's ServiceInstall,
  because that verb also writes the starting config, sets the restart-on-kill actions and opens the
  firewall hole the DNS proxy needs; a second description of all that in XML is a second thing to
  drift.

  The uninstall is deliberately allowed to fail. `curfew uninstall` refuses while a lock is running,
  and that refusal is the product: an uninstaller that ends a session the user asked to be locked
  out of is a bypass with a wizard around it. The message says how to get out properly.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Curfew"
           Manufacturer="Curfew"
           Version="$(Version)"
           UpgradeCode="fe615efe-0155-4855-b07f-aecf30621a81"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Distraction blocking that keeps its promises" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Curfew is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Uninstalling from Settings is the path most people take, so it has to be a first-class
         one: no repair option to click by mistake, and an icon that says which program this is. -->
    <Property Id="ARPPRODUCTICON" Value="curfew.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Satwik-Miyyapuram/curfew" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- No reboot, ever, and no dialog offering one.

         Windows decides whether a restart is needed at InstallValidate, which runs before anything
         that could free a file: before the service is stopped, before the tray is asked to close.
         Restart Manager is left switched on, because a service is exactly what it can deal with —
         it stops Curfew, the files are replaced, it starts it again, and nobody is asked anything.
         The process it could not deal with was the watchdog, which ran from the same curfew.exe
         and is a plain process rather than a service; it now runs from its own copy under
         %ProgramData%, so the only thing holding a file in the install directory is the service.

         REBOOT is suppressed for the case where something is holding a file anyway. A failed
         install can be retried; a restart demanded before the thing has even been installed is a
         worse answer to a smaller problem.

         MsiLogging leaves a verbose log in %TEMP% for every install and uninstall. This dialog is
         the second bug in this file that could only be diagnosed from one. -->
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <Icon Id="curfew.ico" SourceFile="curfew.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Curfew" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="StartupFolder" />

    <Feature Id="Main" Title="Curfew" Level="1">
      <ComponentGroupRef Id="Program" />
    </Feature>

    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Component Id="Cli">
        <File Id="curfew.exe" Source="$(Stage)\curfew.exe" KeyPath="yes" />
        <!-- Stopped before its own file is overwritten, because a running service holds its binary
             open and the copy would fail. Stopping is refused while a lock is running, which is the
             same refusal `curfew uninstall` gives and for the same reason. -->
        <ServiceControl Id="StopCurfew" Name="Curfew" Stop="both" Wait="yes" />
        <!-- On PATH for the terminal commands that have no window yet — editing the config, the
             stats. Nothing in normal use needs it, which is the point of the installer. -->
        <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last"
                     System="yes" Permanent="no" />
      </Component>
      <Component Id="Window">
        <File Id="curfew_app.exe" Source="$(Stage)\curfew-app.exe" KeyPath="yes" />
        <Shortcut Id="StartMenuWindow" Directory="ProgramMenuFolder" Name="Curfew"
                  Description="What is running, what is planned, and whether any of it is working"
                  Advertise="yes" Icon="curfew.ico" />
      </Component>
      <Component Id="Tray">
        <File Id="curfew_tray.exe" Source="$(Stage)\curfew-tray.exe" KeyPath="yes" />
        <!-- Every user's startup, not this one's: the machine has the service, so every account on
             it should be able to see what the service is doing. -->
        <Shortcut Id="StartupTray" Directory="StartupFolder" Name="Curfew"
                  Description="The Curfew tray icon" Advertise="yes" Icon="curfew.ico" />
      </Component>
      <Component Id="Licence">
        <File Id="LICENSE.txt" Source="$(Stage)\LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The tray and the window are ordinary programs of this user's, and they are almost always
         running when an upgrade arrives — the tray is in startup and the window is how people got
         here. A running exe cannot be overwritten, so without this every upgrade ends in "a reboot
         will be required", which is a rude thing to ask of someone who clicked Update. They are
         sent a close message instead, and the tray is started again at the end.

         The service is not in this list. It is stopped by the ServiceControl above, and if it
         refuses to stop, that is a lock running and the refusal is the product. -->
    <util:CloseApplication Id="CloseTray" Target="curfew-tray.exe"
                           CloseMessage="yes" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWindow" Target="curfew-app.exe"
                           CloseMessage="yes" RebootPrompt="no" />
    <!-- The watchdog, which runs from its own copy under %ProgramData% and so holds nothing this
         installer is replacing. It is ended anyway: it exists to start the service again after
         something stops it, and an installer stopping the service is exactly the thing it would
         otherwise undo mid-install. It has no window for a close message to reach, and no state a
         restart would lose. -->
    <util:CloseApplication Id="CloseWatchdog" Target="curfew-watchdog.exe"
                           TerminateProcess="0" RebootPrompt="no" />

    <!-- The service. Deferred and not impersonated, so it runs with the installer's elevation
         rather than the user's; QuietExec so no console flashes over the progress bar. -->
    <SetProperty Id="RegisterService" Sequence="execute" Before="RegisterService"
                 Value="&quot;[INSTALLFOLDER]curfew.exe&quot; install" />
    <CustomAction Id="RegisterService" DllEntry="$(QuietExec)" Execute="deferred"
                  Impersonate="no" Return="check" BinaryRef="$(UtilCA)" />

    <SetProperty Id="RemoveService" Sequence="execute" Before="RemoveService"
                 Value="&quot;[INSTALLFOLDER]curfew.exe&quot; uninstall" />
    <CustomAction Id="RemoveService" DllEntry="$(QuietExec)" Execute="deferred"
                  Impersonate="no" Return="check" BinaryRef="$(UtilCA)" />

    <!-- Started for this session too, so the tray appears without a sign-out. Not impersonated is
         wrong for a tray icon, so this one runs as the user who is installing. -->
    <Property Id="WixShellExecTarget" Value="[#curfew_tray.exe]" />
    <CustomAction Id="StartTray" DllEntry="WixShellExec" Impersonate="yes" Return="ignore"
                  BinaryRef="$(UtilCA)" />

    <InstallExecuteSequence>
      <Custom Action="RegisterService" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RemoveService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="StartTray" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(Stage)\license.rtf" />
  </Package>
</Wix>
