<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Curfew" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      The block screen is opaque rather than a floating dialog: a translucent overlay invites the
      user to keep looking at what is behind it, which is the thing they asked not to look at.
    -->
    <style name="Theme.Curfew.Block" parent="Theme.Curfew">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
