<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Curfew asks for the smallest set of permissions that can enforce a block, and nothing that
      would let it watch the user. There is no INTERNET permission: the whole point of the design
      is that nothing leaves the device, and the absence of the permission is what makes that
      checkable rather than merely promised.
    -->

    <!-- The foreground service that owns enforcement, and the notification that must accompany it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm sessions and alarms after a reboot: a lock that a restart clears is not a lock. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Schedules fire at a minute boundary, so the alarm has to be exact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- The fallback detector when the accessibility service is off, and the usage screen's data. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The block screen draws over the app being blocked. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Device credential is the strictest lock Curfew offers; there is deliberately no way past it. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Reading a physical tag as a way out of a lock. Not required: the device may have no reader,
      or a broken one, and a tag that can only be tapped would be no way out at all on such a
      phone. What is on the tag can always be typed instead.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Calendar rules read events. Read-only, and never written back. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Sync talks to the user's own devices on the local network and to nothing else. There is no
      server, no account and no analytics: the only bytes that leave the device are signed,
      encrypted op-log entries addressed to a device the user paired by hand. Multicast is what
      finds a paired device on the same Wi-Fi without asking anyone on the internet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".CurfewApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curfew">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Curfew">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The block screen. It is a separate task so that dismissing it returns the user to the
          launcher rather than to the app that was blocked, and it excludes itself from recents so
          it cannot be swiped away into the background while a block is live.
        -->
        <activity
            android:name=".block.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="dev.curfew.app.block"
            android:theme="@style/Theme.Curfew.Block" />

        <service
            android:name=".enforce.EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces the user's own focus schedule while it is running." />
        </service>

        <service
            android:name=".enforce.CurfewAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Optional. Without it a mute_notifications rule cannot take a posted notification back
          down; with it Curfew reads only the package name of each notification, never its content.
        -->
        <service
            android:name=".enforce.CurfewNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".enforce.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".enforce.ScheduleAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Optional, and asked for last: being an active device admin is what stops Curfew being
          uninstalled while a lock runs. It claims no policies (res/xml/device_admin.xml) and is not
          device owner, so no factory reset is involved and the user can turn it off at any time.
        -->
        <receiver
            android:name=".enforce.CurfewDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
