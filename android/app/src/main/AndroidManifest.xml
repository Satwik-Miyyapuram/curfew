<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Curfew asks for the smallest set of permissions that can enforce a block, and nothing that
      would let it watch the user.

      It does hold INTERNET, ACCESS_NETWORK_STATE and CHANGE_WIFI_MULTICAST_STATE, and the reason is
      worth stating rather than denying: pairing two devices talks to them directly, over the LAN,
      with no server in between. That is a narrower promise than "no network permission" and a more
      honest one — the claim a user can check is that nothing goes to a server and no account exists,
      and the app writes nothing anywhere else. (An earlier version of this comment claimed there
      was no INTERNET permission at all, which was simply false, and the same sentence had reached
      three screens. See FIXES.md entry 21.)
    -->

    <!-- The foreground service that owns enforcement, and the notification that must accompany it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm sessions and alarms after a reboot: a lock that a restart clears is not a lock. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Schedules fire at a minute boundary, so the alarm has to be exact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- The fallback detector when the accessibility service is off, and the usage screen's data. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The block screen draws over the app being blocked. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Device credential is the strictest lock Curfew offers; there is deliberately no way past it. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Reading a physical tag as a way out of a lock. Not required: the device may have no reader,
      or a broken one, and a tag that can only be tapped would be no way out at all on such a
      phone. What is on the tag can always be typed instead.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Calendar rules read events. Read-only, and never written back. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Sync talks to the user's own devices on the local network and to nothing else. There is no
      server, no account and no analytics: the only bytes that leave the device are signed,
      encrypted op-log entries addressed to a device the user paired by hand. Multicast is what
      finds a paired device on the same Wi-Fi without asking anyone on the internet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".CurfewApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curfew">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Curfew">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="curfew" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="curfew.dev" android:pathPrefix="/pair" />
            </intent-filter>
        </activity>

        <!--
          The block screen. It is a separate task so that dismissing it returns the user to the
          launcher rather than to the app that was blocked, and it excludes itself from recents so
          it cannot be swiped away into the background while a block is live.
        -->
        <activity
            android:name=".block.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="dev.curfew.app.block"
            android:theme="@style/Theme.Curfew.Block" />

        <service
            android:name=".enforce.EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces the user's own focus schedule while it is running." />
        </service>

        <!--
          Two detectors, and the device runs exactly one of them.

          Android applies `canRetrieveWindowContent` per *service*: a service that can read any window
          is treated as one that does, and payment and banking apps refuse to run on that basis alone.
          So the mode a user picks is a choice between capability and cost, and it is presented as
          one — see `EnforcementMode`.

            - ForegroundTracker cannot read a window. App blocking only, no URL rules, no uninstall
              guard. No banking app can object to it. A fresh install is offered this.
            - UrlReaderService can. Browser address bars and the uninstall guard, at the price of the
              banking-app warning. It never reads a payment, banking or credential app: `ScreenWatcher`
              short-circuits those before any node access.

          Both are declared here because the user may switch between them; the wizard shows the one
          the chosen mode uses and tells them if the other is still on, since having both enabled is
          the worst of both worlds — the capability is present and nothing is gained by it.
        -->
        <service
            android:name=".enforce.ForegroundTracker"
            android:exported="true"
            android:label="@string/foreground_tracker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/foreground_tracker_config" />
        </service>

        <service
            android:name=".enforce.UrlReaderService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/url_reader_config" />
        </service>

        <!--
          Optional. Without it a mute_notifications rule cannot take a posted notification back
          down; with it Curfew reads only the package name of each notification, never its content.
        -->
        <service
            android:name=".enforce.CurfewNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".enforce.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Installs and removals, because two things derived from the package list are otherwise frozen
          for the life of the process: the app picker's candidates, and the sensitive list every
          accessibility reader checks. The second is the one that matters — a payment app installed
          while Curfew is running must become unreadable then, not at the next service restart — and
          neither is fixed by anything else, since the platform sends these broadcasts only to
          receivers that asked for them.

          The `data android:scheme="package"` is required rather than decorative: these broadcasts
          carry a `package:` data URI, and an intent filter with no data element does not match an
          intent that has one — so without it this filter silently matches nothing at all.
        -->
        <receiver
            android:name=".enforce.PackageChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!--
          The home screen face. It reports and opens the app; it has no controls, because a lock
          that could be ended from a widget would be a lock with a way round it.
        -->
        <receiver
            android:name=".ui.widget.CurfewWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/curfew_widget_info" />
        </receiver>

        <!-- Same bargain as the widget: it says what is happening, and it does not toggle. -->
        <service
            android:name=".enforce.CurfewTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".enforce.ScheduleAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Optional, and asked for last: being an active device admin is what stops Curfew being
          uninstalled while a lock runs. It claims no policies (res/xml/device_admin.xml) and is not
          device owner, so no factory reset is involved and the user can turn it off at any time.
        -->
        <receiver
            android:name=".enforce.CurfewDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
